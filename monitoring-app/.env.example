# --- Dashboard port (host) ---
APP_PORT=3000

# --- URLs of the monitored services (reachable from the Docker host) ---
VLLM_API_URL=http://172.17.0.1:8000
OPEN_WEBUI_URL=http://172.17.0.1:8080

# Open WebUI admin API token (Settings -> Manage -> API keys).
# Without it only system/GPU/vLLM metrics are collected.
OPEN_WEBUI_API_TOKEN=

# --- Collector ---
# Seconds between collection cycles
COLLECT_INTERVAL=10
# Run the collector inside the backend container (false if a separate
# `python -m collector` worker is used)
RUN_COLLECTOR=true
# Retention (days) for prompt previews / snapshots
PROMPT_RETENTION_DAYS=7
SNAPSHOTS_RETENTION_DAYS=30
# Optional nginx/OWUI access log file (mounted into the container) with
# lines: IP - - [ts] "METHOD /path" status size [rt]
#LOG_FILE=/var/log/nginx/access.log

# --- Auth (HTTP Basic) ---
ADMIN_USER=admin
MONITORING_PASSWORD=admin

# --- API keys (master password required to generate new keys in the UI) ---
MASTER_PASSWORD=apiopenlabs
# Proxy target for the /v1/chat/completions endpoint. Use the vLLM address
# reachable FROM the backend container (e.g. http://172.17.0.1:8000 or
# http://host.docker.internal:8000). VLLM_API_URL above is reused by the proxy.
#
# Optional hardening: set the SAME secret as vLLM's `--api-key` and bind vLLM
# to localhost, so the model is only reachable through this gateway:
#   vLLM:     --api-key=<shared-secret>
#   gateway:  VLLM_API_KEY=<shared-secret>
# (Leave empty if vLLM has no --api-key set.)
VLLM_API_KEY=

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
